erDiagram
    direction LR
    Professores {
        inteiro Id PK
        texto Nome
        texto Email UK
        texto SenhaHash
        texto Especialidade
        texto Telefone
        texto Horario
        datahora DataCadastro
    }
    Alunos ||--o{ Matriculas : ""
    Planos ||--o{ Matriculas : ""
    Matriculas ||--o{ Pagamentos : ""
    Alunos ||--o{ Pagamentos : ""
